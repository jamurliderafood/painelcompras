# Banco (Supabase NOSSO, onde o radar guarda histórico). O painel lê daqui; a
# coleta escreve. Não confundir com o banco do Flow, abaixo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Banco do FLOW, só leitura. É daqui que sai a carteira inteira: uma consulta
# em `organizacoes` devolve os 36 restaurantes, e um restaurante novo entra na
# rodada seguinte sozinho — sem token, sem cadastro.
#
# A connection string é a do **Transaction pooler** do projeto do Flow
# (fvcbxorfstqqeewocxkf), com o usuário `radar_leitura` — o role que tem
# `grant select` só em `public.organizacoes`. Não usar a service_role do Flow:
# ela dá escrita em tudo, e o radar só lê.
#
#   postgresql://radar_leitura:SENHA@aws-0-<regiao>.pooler.supabase.com:6543/postgres
FLOW_DATABASE_URL=

# Protege a rota /api/cron. O Vercel Cron manda este valor no cabeçalho; sem
# ele, qualquer um na internet dispara a coleta da carteira inteira.
CRON_SECRET=

# Caminho de um CSV exportado do SQL Editor do Flow — lê a carteira do disco em
# vez do banco. É como se investiga sem credencial e sem rede.
#
#   select id, nome, atualizado_em, dados::text from organizacoes
#   → Download CSV
#
#   DUMP_FLOW=~/Downloads/flow-organizacoes.csv npm run demo 2026-08-27
DUMP_FLOW=
