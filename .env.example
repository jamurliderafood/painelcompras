# Banco (Supabase nosso, não o do Flow). O painel lê daqui; a coleta escreve.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Flow: um endereço só para toda a carteira, e um token por restaurante.
# Cada FLOW_TOKEN_* define um cliente do radar — é a lista de tokens que forma
# a carteira, porque o Flow não tem endpoint que liste as organizações.
# Gere em Flow → admin → o restaurante → API de integração → Gerar novo token.
FLOW_TOKEN_SOFFRI_GRILL=
FLOW_NOME_SOFFRI_GRILL=Soffri Grill
FLOW_METAS_SOFFRI_GRILL={"cmv":0.32}

# Só para apontar para outro ambiente do Flow. Vazio usa o de produção.
FLOW_API_BASE=

# Protege a rota /api/cron. O Vercel Cron manda este valor no cabeçalho; sem
# ele, qualquer um na internet dispara a coleta da carteira inteira.
CRON_SECRET=

# 'arquivo' lê as respostas salvas em PASTA_FLOW em vez de bater na API.
# É como se investiga um cliente sem gastar chamada e sem o token na máquina.
FONTE=
PASTA_FLOW=
